# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# This file contains template configurations for the Fossil Monorepo
# 
# USAGE:
# 1. For Docker Compose local development:
#    cp .env.example .env.docker
#    cp .env.example .env.local
#    - Update .env.docker with Docker service hostnames (see comments below)
#    - Update .env.local with localhost URLs for external connections
#    - Run: docker-compose -f docker-compose.local.yml up -d
# 
# 2. For native development:
#    cp .env.example .env.local
#    - Update database ports and service URLs as needed
# =============================================================================

# =============================================================================
# STARKNET CONFIGURATION
# =============================================================================
# For .env.local (external connection): http://localhost:5050
# For .env.docker (internal): http://katana:5050
STARKNET_RPC_URL=http://localhost:5050
STARKNET_ACCOUNT=katana-0
STARKNET_ACCOUNT_ADDRESS=0x127fd5f1fe78a71f8bcd1fec63e3fe2f0486b6ecd5c86a0466c3a21fa5cfcec
STARKNET_PRIVATE_KEY=0xc5b2fcab997346f3ea1c00b002ecf6f382c5f9c9659a3894eb783c5320f912

# StarkNet Contract Addresses (will be populated by deploy script)
UNIVERSAL_ECIP_CONTRACT=
GROTH16_VERIFIER_CONTRACT=
PITCHLAKE_VERIFIER_CONTRACT=
HASH_STORAGE_ADDRESS=
PITCHLAKE_VAULT=

FOSSIL_STORE_ADDRESS=0x00e581139553c8666f60b6646f277a336f99f108f8e5fa7cb300b6a6ce7c3b8c
NETWORK=DEVNET_KATANA

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For .env.local (external connection):
#   OFFCHAIN_PROCESSOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres
#   PROVING_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/postgres
# For .env.docker (internal):
#   OFFCHAIN_PROCESSOR_DATABASE_URL=postgresql://postgres:postgres@offchain_processor_db:5432/postgres
#   PROVING_SERVICE_DATABASE_URL=postgresql://postgres:postgres@proving_service_db:5432/postgres

# Offchain Processor Database (read/write - main application database)
OFFCHAIN_PROCESSOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres

# Indexer Database (read-only - populated by fossil indexer service)
INDEXER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Proving Service Database (read/write - job tracking and proof storage)
PROVING_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/postgres

# =============================================================================
# ETHEREUM CONFIGURATION
# =============================================================================
ETH_RPC_URL=http://localhost:8545

# =============================================================================
# SERVICE URLS
# =============================================================================
# For .env.local (external connection): http://127.0.0.1:3001
# For .env.docker (internal): http://proving-service-api:3001
PROVING_SERVICE_URL=http://127.0.0.1:3001

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
USE_MOCK_PRICING_DATA=true
VERIFY_PROOFS_ONCHAIN=true

# =============================================================================
# AWS CONFIGURATION (LocalStack)
# =============================================================================
# For .env.local (external connection): http://localhost:4567
# For .env.docker (internal): http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4567
SQS_QUEUE_URL=http://localhost:4567/000000000000/fossilQueue

# =============================================================================
# BONSAI CONFIGURATION
# =============================================================================
BONSAI_API_KEY="YOUR_API_KEY_HERE"
BONSAI_API_URL="https://api.bonsai.xyz/"

# RISC0 Retry Configuration for Bonsai API
RISC0_MAX_RETRIES=7
RISC0_INITIAL_RETRY_DELAY_MS=3000

# Limit concurrent proof generations to prevent Bonsai API contention
MAX_CONCURRENT_PROOFS=1

# =============================================================================
# STARKNET RETRY CONFIGURATION
# =============================================================================
STARKNET_MAX_RETRIES=3
STARKNET_INITIAL_BACKOFF_MS=100
STARKNET_MAX_BACKOFF_MS=1000
