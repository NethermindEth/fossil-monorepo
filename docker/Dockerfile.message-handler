# Build stage
FROM --platform=linux/amd64 rust:1.88-slim AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install RISC Zero
RUN curl -L https://risczero.com/install | bash
ENV PATH="/root/.risc0/bin:${PATH}"
RUN /root/.risc0/bin/rzup install

# Set working directory
WORKDIR /app

# Copy proving-service workspace
COPY proving-service/Cargo.toml ./Cargo.toml
COPY proving-service/Cargo.lock ./Cargo.lock
COPY proving-service/crates ./crates

# Build the message-handler with mock-proof features
RUN cargo build --release --bin message-handler --package message-handler --features mock-proof

# Runtime stage
FROM --platform=linux/amd64 ubuntu:noble

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories for RISC0 methods
RUN mkdir -p /app/target/release/build/mock-proof-composition-methods/out

# Copy the binary from builder
COPY --from=builder /app/target/release/message-handler /usr/local/bin/message-handler
RUN chmod +x /usr/local/bin/message-handler

# Copy RISC0 method ELFs from builder
COPY --from=builder /app/target/release/build/mock-proof-composition-methods-*/out/. /app/target/release/build/mock-proof-composition-methods/out/

# Set environment variables
ENV RUST_LOG=info

# Create wrapper script for message-handler
RUN printf '%s\n' \
    '#!/bin/bash' \
    '' \
    '# Run the message-handler application' \
    'exec /usr/local/bin/message-handler "$@"' \
    > /usr/local/bin/message-handler-wrapper.sh

RUN chmod +x /usr/local/bin/message-handler-wrapper.sh

# Use ENTRYPOINT so it runs even with empty entrypoint/command arrays
ENTRYPOINT ["/usr/local/bin/message-handler-wrapper.sh"]