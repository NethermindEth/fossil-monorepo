# Test environment configuration for starknet-handler
# Copy this to .env for local testing

# Local StarkNet RPC endpoint
STARKNET_RPC_URL=http://localhost:5050

# Test contract address (replace with actual deployed fossil_store contract)
FOSSIL_STORE_ADDRESS=0x027a6e498bfad98a5145ac507f90fac6268cce6c0373c6eecd38de46be655b55

# Retry configuration for testing
STARKNET_MAX_RETRIES=3
STARKNET_INITIAL_BACKOFF_MS=100
STARKNET_MAX_BACKOFF_MS=1000
