use pitchlake_verifier::PitchLakeJobRequest;
use pitchlake_verifier::pitchlake_verifier::{
    IPitchLakeVerifierDispatcher, IPitchLakeVerifierDispatcherTrait,
};
use snforge_std::{ContractClassTrait, DeclareResultTrait, declare};

fn OWNER() -> starknet::ContractAddress {
    'OWNER'.try_into().unwrap()
}

struct Dispatchers {
    risc0_verifier_address: starknet::ContractAddress,
    pl_vault_address: starknet::ContractAddress,
    pl_verifier: IPitchLakeVerifierDispatcher,
}

fn deploy() -> Dispatchers {
    let ecip_class = declare("UniversalECIP").unwrap().contract_class();
    let ecip_class_felt: felt252 = (*ecip_class.class_hash).into();

    let risc0_class = declare("Risc0Groth16VerifierBN254").unwrap().contract_class();
    let (risc0_verifier_address, _) = risc0_class.deploy(@array![ecip_class_felt]).unwrap();

    let pl_vault_class = declare("Vault").unwrap().contract_class();
    let (pl_vault_address, _) = pl_vault_class.deploy(@array![]).unwrap();

    let pl_verifier_class = declare("PitchLakeVerifier").unwrap().contract_class();
    let (pl_verifier_address, _) = pl_verifier_class
        .deploy(@array![risc0_verifier_address.into(), OWNER().into()])
        .unwrap();

    Dispatchers {
        risc0_verifier_address,
        pl_vault_address,
        pl_verifier: IPitchLakeVerifierDispatcher { contract_address: pl_verifier_address },
    }
}

#[test]
fn test_verify() {
    let dsp = deploy();

    let job_request = PitchLakeJobRequest {
        vault_address: dsp.pl_vault_address, timestamp: 1234567890, program_id: 'PROGRAM_ID',
    };
    let proof_calldata = PROOF_CALLDATA().span();

    let _ = dsp.pl_verifier.verify_proof(proof_calldata, job_request);
}

